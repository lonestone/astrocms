# Git
GIT_REPO_URL=https://github.com/user/repo
# With PR-based edits enabled, this names the BASE branch (the protected one).
GIT_BRANCH=main
GIT_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GIT_USER_EMAIL=cms@astrocms.dev
GIT_USER_NAME=AstroCMS

# PR-based edits (also settable via the "git" block in astrocms.json):
# the CMS works on a branch you create from the UI and opens pull requests
# instead of pushing to GIT_BRANCH. 1/true enables, any other non-empty value
# disables; empty keeps the astrocms.json value.
ASTROCMS_PR_BASED_EDITS=
