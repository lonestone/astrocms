{
  "name": "astrocms",
  "version": "0.2.0",
  "description": "A headless CMS for Astro with a built-in AI agent for editing content.",
  "type": "module",
  "license": "MIT",
  "author": "Godefroy de Compreignac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lonestone/astrocms.git"
  },
  "homepage": "https://github.com/lonestone/astrocms#readme",
  "bugs": {
    "url": "https://github.com/lonestone/astrocms/issues"
  },
  "keywords": [
    "astro",
    "cms",
    "headless-cms",
    "content-management",
    "ai",
    "agent",
    "markdown",
    "mdx"
  ],
  "bin": {
    "astrocms": "bin/astrocms.js"
  },
  "files": [
    "backend",
    "shared",
    "dist",
    "bin",
    "patches"
  ],
  "scripts": {
    "dev": "tsx watch backend/server.ts & vite dev --config frontend/vite.config.ts",
    "dev:server": "tsx watch backend/server.ts",
    "dev:frontend": "vite dev --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "cp ../../README.md ./README.md",
    "postpack": "rm -f ./README.md"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.16",
    "@assistant-ui/react-ai-sdk": "1.4.7",
    "@babel/parser": "^7.29.8",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/view": "^6.43.9",
    "@hono/node-server": "^2.1.1",
    "@lezer/highlight": "^1.2.3",
    "@mdxeditor/editor": "^4.2.1",
    "@tanstack/react-query": "^5.102.2",
    "@types/diff": "^7.0.2",
    "ai": "^7.0.77",
    "ai-sdk-provider-claude-code": "^4.1.1",
    "cm6-graphql": "^0.2.1",
    "country-flag-icons": "^1.6.20",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.4",
    "jiti": "^2.7.0",
    "marked": "^18.0.10",
    "picomatch": "^4.0.5",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router": "^8.3.0",
    "smol-toml": "^1.8.0",
    "tsx": "^4.23.12",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/types": "^7.29.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/picomatch": "^4.0.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "comments": {
    "overrides": "@assistant-ui publishes tightly-coupled packages whose semver ranges allow mutually incompatible combinations (e.g. a newer store drops an export that core still imports). The two direct deps above are pinned exact and these transitive ones are pinned here, so the Docker build's fresh `npm install` (no lockfile) resolves the same known-good tree we test locally."
  },
  "overrides": {
    "@assistant-ui/core": "0.3.15",
    "@assistant-ui/store": "0.3.10",
    "@assistant-ui/tap": "0.9.14"
  }
}
